# Copy to apps/web/.env.local

# Public base URL of the Express API. No trailing slash. This is the only
# variable the browser sees, which is why it carries no secret.
#   local:      http://localhost:4000
#   production: https://ipk-api.onrender.com
NEXT_PUBLIC_API_URL=http://localhost:4000

# Production on Vercel: proxy the API through this origin so the session cookie
# is first-party (browsers that block third-party cookies otherwise drop it and
# every request after login returns 401). Set both:
#   API_PROXY_URL=https://ipk-api.onrender.com
#   NEXT_PUBLIC_API_URL=/
# API_PROXY_URL=
