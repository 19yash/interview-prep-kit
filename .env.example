# ---------------------------------------------------------------------------
# Copy to .env and fill in. Nothing here is committed — .env is gitignored.
# ---------------------------------------------------------------------------

# --- Model provider -------------------------------------------------------
# Google AI Studio key for Gemini. Free, no card: aistudio.google.com/apikey
# Used by every generation step, always through packages/core/src/llm/client.ts
GEMINI_API_KEY=

# Model id for every generation step. gemini-3.6-flash is the active free-tier
# model supporting JSON schema enforcement.
GEMINI_MODEL=gemini-3.6-flash

# --- API ------------------------------------------------------------------
# Port the Express server listens on. Render sets this automatically; locally 4000.
PORT=4000

# MongoDB connection string. Atlas free tier provides:
# mongodb+srv://<user>:<password>@<cluster>.mongodb.net/ipk
MONGODB_URI=mongodb://127.0.0.1:27017/ipk

# Secret used to sign session cookies. Generate with:
#   openssl rand -hex 32
# Changing it signs every existing session out.
JWT_SECRET=

# Origins allowed to call the API with credentials. Comma-separated, so a
# Vercel preview deployment can be allowed alongside production. No trailing slash.
#   e.g. http://localhost:3000,https://interview-prep-kit.vercel.app
WEB_ORIGIN=http://localhost:3000

# production enables secure, sameSite=none cookies and blocks fetching
# private/loopback addresses. Development allows localhost fetching for the batch command.
NODE_ENV=development

# --- Web (client) ---------------------------------------------------------
# Public base URL of the API, read by the Next.js app at build and run time.
NEXT_PUBLIC_API_URL=http://localhost:4000
